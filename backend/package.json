{
  "name": "org-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:reset": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
