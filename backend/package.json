{
  "name": "org-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/migrate-up.js && node dist/server.js",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:up": "tsx --env-file-if-exists=.env src/migrate-up.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "check:connectors": "tsx scripts/check-connector-endpoints.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
