# Copy to .env and adjust if you're not using the bundled docker-compose Postgres.
# Both have working defaults baked into src/db/pool.ts and scripts/*.ts, so this file
# is only needed to override them (e.g. a different port, a managed Postgres instance).

# NODE_ENV=production is what a real deployment (Railway, etc.) sets automatically — it's
# what server.ts keys off of to serve the built frontend from this same process, mark the
# session cookie `secure`, and disable cross-origin CORS. Leave unset for local dev; never
# set it by hand here.

# Used by the running server — the least-privileged app role (no UPDATE/DELETE on
# audit_log or policy_revisions; see backend/db/schema.sql).
DATABASE_URL=postgres://mesh_app:mesh_app_dev_only@localhost:5433/agent_org_mesh

# Used only by scripts/migrate.ts and scripts/seed-db.ts — the role that owns the schema.
DATABASE_ADMIN_URL=postgres://mesh_admin:mesh_admin_dev_only@localhost:5433/agent_org_mesh

# --- Real integrations (Set up my agent → "What did I do today?") ---
# Without these, the daily-summary feature returns a clear "not configured" error;
# everything else in the app works fine without them.

# --- Main-agent model providers ---
# Whichever runtime an org admin sets as the org's one MAIN agent (Admin → Organizations)
# determines which of these two actually answers real questions for everyone in that org
# — see integrations/runtimeProvider.ts and docs/agent-to-agent-communication.md's
# "model-agnostic main agents" section. Neither is required for the rest of the app to
# work; an org whose provider isn't configured just gets the raw authorized data instead
# of AI-written prose.

# Anthropic — used when the org's main agent is Claude. Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI-compatible — used when the org's main agent is ChatGPT, or any open-source /
# locally-deployed model (Ollama, vLLM, LM Studio, ...) that speaks the same wire format.
# Point OPENAI_BASE_URL at a local server to use a local model instead of OpenAI's own API
# — no code change needed, just these three values.
#
# Verified working examples — a real local Ollama model, no OpenAI account needed at all:
#   brew install ollama && brew services start ollama && ollama pull qwen3:8b
#   OPENAI_API_KEY=ollama-local-no-key-required   (Ollama doesn't check this value)
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen3:8b
# qwen3:8b (~5.2 GB) gives noticeably more coherent synthesis than llama3.2:1b (~1.3 GB,
# the original smaller model this was first verified against — still works, just weaker
# at following the synthesis prompt). Ollama returns Qwen3's reasoning output in a
# separate `reasoning` field, never mixed into `content`, so no adapter code depends on
# which of the two you pick. Full walkthrough + what was live-verified:
# docs/agent-to-agent-communication.md §15a.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Lets individual organizations bring their own provider key/endpoint instead of sharing
# the platform-wide ANTHROPIC_API_KEY/OPENAI_* above (Admin → Organizations → main agent
# → "Use our own credentials") — the key an org supplies is encrypted with this before it
# ever reaches Postgres (domain/crypto.ts, AES-256-GCM). Required only if any org actually
# sets its own key; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this locks every org's stored override — they'd need to re-enter it.
CREDENTIAL_ENCRYPTION_KEY=

# Real transactional email (Resend, resend.com) — sent the moment someone's invited as
# an org admin or added to a chart with an email, so the temp password doesn't only ever
# live on the inviting admin's own screen. Without this, invites still work exactly the
# same — the temp password is still shown once in the UI, it just isn't also emailed.
# See integrations/resendEmail.ts's module comment: built the same way as every other
# connector here, but UNVERIFIED against a real send — no real Resend key has been
# available to test with yet.
RESEND_API_KEY=
# Must be on a domain verified in your Resend account, or Resend's own onboarding@resend.dev
# test address (delivers only to the account's own verified email — fine for local dev).
EMAIL_FROM=Agent Org Mesh <onboarding@resend.dev>

# Google OAuth 2.0 Web application credentials (Google Cloud Console → APIs & Services →
# Credentials). Enable the Gmail API on the same project first. Add GOOGLE_REDIRECT_URI
# below as an authorized redirect URI on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/gmail/callback

# Where the browser lands after Gmail consent completes.
FRONTEND_URL=http://localhost:5173
